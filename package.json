{
  "name": "@simomosi/dynamic-forms",
  "version": "3.0.0",
  "description": "DynamicForms is a js library that handles all interactions in forms with dynamic content (e.g. select with variable options, updating rules and visibility changes depending on fields' state).",
  "type": "module",
  "main": "dist/dynamic-forms.umd.cjs",
  "module": "dist/dynamic-forms.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/dynamic-forms.umd.js",
  "jsdelivr": "dist/dynamic-forms.umd.js",
  "files": [
    "dist",
    "src"
  ],
  "author": "simomosi (https://github.com/simomosi)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simomosi/dynamic-forms.git"
  },
  "homepage": "https://simomosi.github.io/dynamic-forms/",
  "bugs": "https://github.com/simomosi/dynamic-forms/issues",
  "keywords": [
    "form",
    "dynamic",
    "update",
    "rule",
    "visibility",
    "select",
    "option",
    "dropdown",
    "async",
    "promise",
    "declarative",
    "json",
    "configuration",
    "vanilla",
    "javascript",
    "progressive",
    "filtering",
    "typescript",
    "vite",
    "esm"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@mermaid-js/mermaid-cli": "^10.1.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^29.1.1",
    "mermaid": "^10.1.0",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "source-map-js": "^1.2.2",
    "tsdown": "0.23.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint:package": "publint && attw --pack .",
    "test:package": "npm run build && vitest run --config vitest.package.config.ts",
    "size": "size-limit"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/dynamic-forms.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/dynamic-forms.umd.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
